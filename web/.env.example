# Copy to .env.local (or add these in Vercel → Settings → Environment Variables).
# Fill in the addresses printed by `npx hardhat run scripts/deploy.js --network baseSepolia`.
# The /demo page works without any of these.

NEXT_PUBLIC_FACTORY_ADDRESS=
NEXT_PUBLIC_USDC_ADDRESS=

# "false" if NEXT_PUBLIC_USDC_ADDRESS is real USDC (hides the "get test USDC" button).
NEXT_PUBLIC_USDC_IS_MOCK=true

# Optional: your own Base Sepolia RPC. Defaults to the public one.
NEXT_PUBLIC_RPC_URL=

# Telegram bot username (no @) for guardian alerts; see ../alerts/README.md. Leave empty to hide the subscribe links.
NEXT_PUBLIC_ALERT_BOT=usemora_bot
